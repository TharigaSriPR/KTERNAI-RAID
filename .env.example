# Environment Configuration for KTern.AI RAID Identification Agent POC

# LLM Provider Configuration
# Supported providers: openrouter (default/Gemma), gemini, mock
LLM_PROVIDER=openrouter
LLM_MODEL=gemini-2.0-flash

# OpenRouter Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# Google Gemini API Credentials
GEMINI_API_KEY=your_gemini_api_key_here
# Alternatively:
# GOOGLE_API_KEY=your_gemini_api_key_here

# Request Reliability and Budgets
LLM_REQUEST_TIMEOUT=30.0
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=1.0
LLM_MAX_INPUT_LENGTH=4000

# Scoring Thresholds
CONFIDENCE_THRESHOLD=0.75
DEDUPE_SIMILARITY_THRESHOLD=0.82

# Centralised Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
